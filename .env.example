# Copy to .env and fill in. The app runs fully in DEMO mode with none of these set.

# Server
PORT=3000
# Public base URL used when generating payment links (no trailing slash).
# In production set this to your real domain so links work when pasted into WhatsApp/Instagram.
BASE_URL=http://localhost:3000

# Secret used to sign seller session tokens. Set a long random value in production.
APP_SECRET=change-me-to-a-long-random-string

# --- Paystack (https://paystack.com) ---
# When set, real Paystack checkout + webhooks are used. When empty, the app runs
# in DEMO mode with a simulated checkout so you can see the whole flow end-to-end.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- WhatsApp Cloud API (optional) ---
# When set, payment confirmations are sent back into the WhatsApp thread automatically.
# When empty, confirmations are recorded and shown in the app but not actually sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
